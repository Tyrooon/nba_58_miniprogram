.page-container {
  background-color: #f7f8fa;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.header {
  position: sticky;
  top: 0;
  z-index: 100;
  background-color: #fff;
  padding: 20rpx 30rpx 30rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.season-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.season-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2937;
}

.season-type {
  font-size: 24rpx;
  color: #6B7280;
  background: #F3F4F6;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.mode-status-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.mode-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.mode-label {
  font-size: 24rpx;
  color: #6B7280;
}

.mode-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
}

.mode-lock {
  margin-left: auto;
  font-size: 22rpx;
  color: #EF4444;
}

.season-picker {
  display: flex;
  align-items: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2937;
}

.picker-arrow {
  margin-left: 10rpx;
  font-size: 20rpx;
  color: #6B7280;
}

.actions {
  display: flex;
  gap: 16rpx;
}

.mode-badge {
  background: #EFF6FF;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  transition: all 0.2s ease;
  position: relative;
  overflow: hidden;
}

.mode-badge:active {
  transform: scale(0.95);
  background: #DBEAFE;
}

/* Ripple effect */
.mode-badge::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 0;
  height: 0;
  border-radius: 50%;
  background: rgba(59, 130, 246, 0.2);
  transform: translate(-50%, -50%);
  transition: width 0.3s, height 0.3s;
}

.mode-badge:active::after {
  width: 200%;
  height: 200%;
}

.mode-badge text {
  color: #3B82F6;
  font-size: 24rpx;
  font-weight: 600;
}

.timeline-scroll {
  flex: 1;
  height: 0;
}

.timeline-content {
  padding-bottom: 40rpx;
}

.loading-more {
  height: 80rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #f3f3f3;
  border-top: 4rpx solid #3B82F6;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.date-group {
  margin-bottom: 20rpx;
}

.date-header {
  background: #F3F4F6;
  padding: 12rpx 30rpx;
  font-size: 26rpx;
  color: #6B7280;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.date-header.is-today {
  background: #DBEAFE;
  color: #1E40AF;
}

.day-text {
  font-weight: 600;
}

.today-tag {
  background: #2563EB;
  color: white;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.game-card {
  background: #fff;
  margin: 20rpx 30rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.03);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.game-card:active .game-summary {
  background: #F9FAFB;
}

.game-card.expanded {
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.1);
  transform: translateY(-2rpx);
}

/* Expand arrow animation */
.expand-tag {
  transition: transform 0.3s ease;
}

.game-card.expanded .expand-tag {
  transform: translateX(-50%) rotate(180deg);
}

.game-summary {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  position: relative;
}

.expand-tag {
    position: absolute;
    bottom: 10rpx;
    left: 50%;
    transform: translateX(-50%);
    font-size: 16rpx;
    color: #9CA3AF;
}

.team-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 160rpx;
}

.team-logo {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 10rpx;
}

.team-name {
  font-size: 26rpx;
  color: #374151;
  font-weight: 600;
  text-align: center;
}

.score-board {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.score-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 6rpx;
}

.vs-text {
  font-size: 36rpx;
  font-weight: 800;
  color: #D1D5DB;
}

.score-num {
  font-size: 48rpx;
  font-weight: 800;
  color: #1F2937;
}

.score-num.win {
    color: #000;
}

/* Live score style */
.score-num.live {
    color: #3B82F6; /* Blue for live */
}

.score-divider {
  font-size: 32rpx;
  color: #9CA3AF;
  margin: 0 10rpx;
}

.game-status-row {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.status-text {
  font-size: 20rpx;
  font-weight: 600;
  color: #6B7280;
  background: #F3F4F6;
  padding: 4rpx 12rpx;
  border-radius: 100rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

/* Live status indicator */
.status-text.live {
  background: #FEE2E2;
  color: #DC2626;
}

.status-text.live::before {
  content: '';
  width: 8rpx;
  height: 8rpx;
  background: #DC2626;
  border-radius: 50%;
  animation: liveDot 1.5s ease-in-out infinite;
}

@keyframes liveDot {
  0%, 100% {
    opacity: 1;
    transform: scale(1);
  }
  50% {
    opacity: 0.5;
    transform: scale(0.8);
  }
}

.time-text {
  font-size: 20rpx;
  color: #9CA3AF;
}

.players-section {
  background: #F9FAFB;
  padding: 24rpx;
  border-top: 1px solid #F3F4F6;
}

.divider {
    width: 100%;
    height: 1px;
    background: #E5E7EB;
    margin-bottom: 20rpx;
}

.section-label {
  font-size: 24rpx;
  color: #6B7280;
  margin-bottom: 20rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-label .refresh-text {
    color: #3B82F6;
    font-weight: normal;
    padding: 4rpx 12rpx;
    background: #EFF6FF;
    border-radius: 8rpx;
    font-size: 20rpx;
    transition: all 0.2s ease;
}

.section-label .refresh-text:active {
  background: #DBEAFE;
  transform: scale(0.95);
}

/* Loading spinner enhancement */
.spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #f3f3f3;
  border-top: 4rpx solid #3B82F6;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

/* Card loading state with fade in */
.card-loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 40rpx;
    color: #9CA3AF;
    font-size: 24rpx;
    gap: 16rpx;
    animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(-10rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Live score pulse for ongoing games */
.score-num.live {
    color: #3B82F6;
    animation: livePulse 1.5s ease-in-out infinite;
}

@keyframes livePulse {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.8;
  }
}

/* Mini sync button enhancement */
.mini-sync-btn {
    background: #EFF6FF;
    color: #3B82F6;
    transition: all 0.2s ease;
}

.mini-sync-btn:active {
  background: #DBEAFE;
  transform: scale(0.95);
}

.card-loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 40rpx;
    color: #9CA3AF;
    font-size: 24rpx;
  gap: 16rpx;
}

.players-columns {
  display: flex;
  gap: 20rpx;
  flex-wrap: nowrap;
  align-items: flex-start;
}

.team-column {
  flex: 1;
  min-width: 0;
  background: #fff;
  border: 1px solid #E5E7EB;
  border-radius: 16rpx;
  padding: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  box-shadow: inset 0 0 0 1rpx rgba(0,0,0,0.02);
}

.team-column.visitor-column {
  border-color: #BFDBFE;
}

.team-column.home-column {
  border-color: #FECACA;
}

.team-column-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.team-column-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #111827;
}

.team-column-sub {
  font-size: 22rpx;
  color: #9CA3AF;
}

.team-column-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.player-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.player-chip {
  background: #fff;
  border: 1px solid #E5E7EB;
  border-radius: 12rpx;
  padding: 10rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  width: 100%;
  box-sizing: border-box;
  transition: all 0.2s ease;
  position: relative;
  overflow: hidden;
}

.player-chip:active {
  transform: scale(0.98);
  border-color: #3B82F6;
  background: #EFF6FF;
}

/* Selected state for player chip */
.player-chip.selected {
  border-color: #3B82F6;
  background: #EFF6FF;
}

/* Pulse animation for selected/highlighted */
.player-chip.selected::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: 12rpx;
  animation: pulse 2s ease-in-out infinite;
  pointer-events: none;
}

@keyframes pulse {
  0%, 100% {
    box-shadow: 0 0 0 0 rgba(59, 130, 246, 0.4);
  }
  50% {
    box-shadow: 0 0 0 8rpx rgba(59, 130, 246, 0);
  }
}

.player-chip.disabled {
    opacity: 0.5;
    background: #F3F4F6;
}

.player-chip.disabled:active {
  transform: none;
  border-color: #E5E7EB;
  background: #F3F4F6;
}

.player-info {
  display: flex;
  flex-direction: column;
}

.p-avg-inline {
  font-size: 20rpx;
  color: #3B82F6;
  margin-top: 4rpx;
}

.p-name {
  font-size: 22rpx;
  font-weight: 600;
  color: #1F2937;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.p-team {
  font-size: 18rpx;
  color: #9CA3AF;
}

.p-stat {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.p-avg {
  font-size: 22rpx;
  color: #3B82F6;
  font-weight: 700;
}

.p-live-score {
    font-size: 28rpx;
    color: #1F2937;
    font-weight: 800;
}

.p-live-score.high {
    color: #EF4444;
}

.p-live-sub {
    font-size: 20rpx;
    color: #9CA3AF;
    margin-left: 4rpx;
}

.no-players {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 40rpx 0;
    color: #9CA3AF;
    gap: 20rpx;
}

.no-players-mini {
  text-align: center;
  color: #9CA3AF;
  font-size: 22rpx;
  padding: 30rpx 0;
}

.mini-sync-btn {
    background: #EFF6FF;
    color: #3B82F6;
}

.no-games-day {
  text-align: center;
  padding: 40rpx;
  color: #9CA3AF;
  font-size: 26rpx;
  background: white;
  border-radius: 24rpx;
  border: 1px dashed #E5E7EB;
}

.floating-refresh {
  position: fixed;
  right: 30rpx;
  bottom: 240rpx;
  width: 100rpx;
  height: 100rpx;
  background: #3B82F6;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(59, 130, 246, 0.4);
  z-index: 9999;
  transition: transform 0.2s;
}

.floating-refresh:active {
  transform: scale(0.9);
}

.refresh-icon {
  color: white;
  font-size: 50rpx;
  line-height: 1;
  font-weight: bold;
}

/* 到底提示 */
.end-tip {
  text-align: center;
  padding: 30rpx;
  color: #9CA3AF;
  font-size: 24rpx;
}

/* 玩法卡片收起状态 */
.mode-status-card.collapsed {
  padding: 16rpx 24rpx;
}

.mode-card-content {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.mode-card-collapsed {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.mode-icon-badge {
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  border-width: 2rpx;
  border-style: solid;
}

/* 常规模式：浅蓝色底+深蓝色字+深蓝色边框 */
.mode-icon-badge.mode-1 {
  background: #EFF6FF;
  color: #1E40AF;
  border-color: #3B82F6;
}

/* 正58模式：浅红色底+深红色字+深红色边框 */
.mode-icon-badge.mode-2 {
  background: #FEE2E2;
  color: #991B1B;
  border-color: #DC2626;
}

/* 负58模式：浅绿色底+深绿色字+深绿色边框 */
.mode-icon-badge.mode-3 {
  background: #DCFCE7;
  color: #166534;
  border-color: #16A34A;
}

.collapsed-date {
  flex: 1;
  font-size: 28rpx;
  color: #374151;
  font-weight: 500;
}

.collapse-arrow {
  font-size: 20rpx;
  color: #9CA3AF;
}
