<view class="container">
  <view class="header">
    <view class="back-btn" bindtap="handleBack">←</view>
    <view class="title">经理模式</view>
    <view class="placeholder"></view>
  </view>

  <!-- Tab导航 -->
  <view class="tab-bar">
    <view class="tab-item {{activeTab === 'roster' ? 'active' : ''}}" bindtap="switchTab" data-tab="roster">阵容</view>
    <view class="tab-item {{activeTab === 'starters' ? 'active' : ''}}" bindtap="switchTab" data-tab="starters">首发</view>
    <view class="tab-item {{activeTab === 'trades' ? 'active' : ''}}" bindtap="switchTab" data-tab="trades">交易</view>
    <!-- 选秀Tab暂时冻结 -->
    <!-- <view class="tab-item {{activeTab === 'draft' ? 'active' : ''}}" bindtap="switchTab" data-tab="draft">选秀</view> -->
  </view>

  <view class="content" wx:if="{{!loading}}">
    <!-- 阵容Tab -->
    <view wx:if="{{activeTab === 'roster'}}">
      <view class="section">
        <view class="section-title">我的阵容 ({{roster.length}})</view>
        <view class="roster-list" wx:if="{{roster.length > 0}}">
          <view class="roster-item" wx:for="{{roster}}" wx:key="id" data-player="{{item}}" bindtap="handleRosterClick">
            <view class="player-info">
              <view class="player-name">
                {{item.player_name}}
                <text class="rookie-tag" wx:if="{{item.player_type === 'rookie'}}">新</text>
              </view>
              <view class="player-meta">
                <text class="team">{{item.team_name}}</text>
                <text class="position">{{item.position}}</text>
              </view>
            </view>
            <view class="player-status">
              <text class="status-text starter" wx:if="{{item.is_starter}}">首发</text>
              <text class="status-text injured" wx:if="{{item.is_injured}}">伤病</text>
              <view class="actions">
                <text class="action-btn" bindtap="handleInjuryAction" data-player="{{item}}" data-action="{{item.is_injured ? 'release' : 'move'}}" catchtap="true">
                  {{item.is_injured ? '恢复' : '伤病'}}
                </text>
                <text class="action-btn delete" bindtap="removePlayer" data-player="{{item}}" catchtap="true">移除</text>
              </view>
            </view>
          </view>
        </view>
        <view class="empty-tip" wx:else>
          <text>暂无阵容，请先通过选秀获取球员</text>
        </view>
      </view>
    </view>

    <!-- 首发Tab -->
    <view wx:if="{{activeTab === 'starters'}}">
      <view class="section">
        <view class="section-header">
          <view class="section-title">设置首发 (已选 {{starterIds.length}}/5)</view>
          <text class="save-btn" bindtap="setStarters">保存</text>
        </view>
        <view class="roster-list" wx:if="{{roster.length > 0}}">
          <view class="roster-item starter-item" wx:for="{{roster}}" wx:key="id" data-player="{{item}}">
            <view class="player-info">
              <view class="player-name">
                {{item.player_name}}
                <text class="rookie-tag" wx:if="{{item.player_type === 'rookie'}}">新</text>
              </view>
              <view class="player-meta">
                <text class="team">{{item.team_name}}</text>
                <text class="position">{{item.position}}</text>
              </view>
            </view>
            <view class="player-status">
              <view class="checkbox {{starterIds.includes(item.player_id) && !item.is_injured ? 'checked' : ''}}" bindtap="toggleStarter" data-player-id="{{item.player_id}}" wx:if="{{!item.is_injured}}">
                <text wx:if="{{starterIds.includes(item.player_id)}}">✓</text>
              </view>
              <text class="disabled-text" wx:if="{{item.is_injured}}">伤病</text>
            </view>
          </view>
        </view>
        <view class="tip-box">
          <text>提示：必须选择5名首发球员，其中至少包含1名新秀</text>
        </view>
      </view>
    </view>

    <!-- 交易Tab -->
    <view wx:if="{{activeTab === 'trades'}}">
      <view class="section">
        <view class="section-header">
          <view class="section-title">待处理交易</view>
          <text class="add-btn" bindtap="showCreateTrade">+ 发起交易</text>
        </view>
        <view class="trade-list" wx:if="{{pendingTrades.length > 0}}">
          <view class="trade-item" wx:for="{{pendingTrades}}" wx:key="id">
            <view class="trade-info">
              <text class="trade-users">{{item.from_user_nickname}} → {{item.to_user_nickname}}</text>
              <text class="trade-details">交易详情：{{item.trade_details}}</text>
              <view class="trade-votes">
                <text class="vote-for">支持: {{item.votes_for}}</text>
                <text class="vote-against">反对: {{item.votes_against}}</text>
              </view>
            </view>
            <view class="trade-actions">
              <text class="vote-btn approve" bindtap="voteOnTrade" data-trade-id="{{item.id}}" data-vote="{{true}}">支持</text>
              <text class="vote-btn reject" bindtap="voteOnTrade" data-trade-id="{{item.id}}" data-vote="{{false}}">反对</text>
            </view>
          </view>
        </view>
        <view class="empty-tip" wx:else>
          <text>暂无待处理的交易</text>
        </view>
      </view>
    </view>

    <!-- 选秀Tab - 暂时冻结 -->
    <!-- <view wx:if="{{activeTab === 'draft'}}">
      <view class="section">
        <view class="section-header">
          <view class="section-title">选秀顺序</view>
          <text class="reshuffle-btn" bindtap="showReshuffleModal">重选秀</text>
        </view>
        <view class="draft-order-list" wx:if="{{draftOrder.length > 0}}">
          <view class="draft-order-item" wx:for="{{draftOrder}}" wx:key="{{item}}">
            <text class="order-num">{{index + 1}}.</text>
            <text class="order-user">用户{{item}}</text>
          </view>
        </view>
        <view class="empty-tip" wx:else>
          <text>选秀顺序加载中...</text>
        </view>
      </view>
    </view> -->

    <!-- 周得分展示（在阵容tab下方） -->
    <view class="section" wx:if="{{activeTab === 'roster'}}">
      <view class="section-title">本周得分</view>
      <view class="score-list" wx:if="{{weeklyScores.length > 0}}">
        <view class="score-item" wx:for="{{weeklyScores}}" wx:key="id" data-score="{{item}}" bindtap="handleScoreClick">
          <view class="score-info">
            <text class="score-name">{{item.nickname}}</text>
            <text class="score-points">{{item.total_points || 0}}分</text>
          </view>
          <text class="score-rank">#{{item.rank || '-'}}</text>
        </view>
      </view>
      <view class="empty-tip" wx:else>
        <text>暂无得分数据</text>
      </view>
    </view>
  </view>

  <!-- 加载中 -->
  <view class="loading-container" wx:if="{{loading}}">
    <view class="spinner"></view>
    <text>加载中...</text>
  </view>

