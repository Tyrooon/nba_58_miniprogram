.container {
  min-height: 100vh;
  background: #f7f8fa;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px;
  background: white;
  position: sticky;
  top: 0;
  z-index: 10;
}

.back-btn {
  font-size: 24px;
  color: #1f2937;
  padding: 8px;
  margin-left: -8px;
}

.title {
  font-size: 18px;
  font-weight: 600;
  color: #1f2937;
}

.placeholder {
  width: 32px;
}

.content {
  padding: 16px;
}

.section {
  background: white;
  border-radius: 16px;
  padding: 20px;
  margin-bottom: 16px;
}

.section-title {
  font-size: 16px;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 16px;
}

.roster-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.roster-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px;
  background: #f3f4f6;
  border-radius: 12px;
}

.player-info {
  flex: 1;
}

.player-name {
  font-size: 16px;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 4px;
}

.player-meta {
  display: flex;
  gap: 12px;
  font-size: 12px;
  color: #6b7280;
}

.player-meta .team {
  color: #3b82f6;
}

.player-meta .type {
  padding: 2px 8px;
  border-radius: 4px;
  background: #e5e7eb;
}

.player-meta .type.rookie {
  background: #dbeafe;
  color: #1d4ed8;
}

.player-status {
  display: flex;
  gap: 8px;
}

.status-text {
  font-size: 11px;
  padding: 4px 8px;
  border-radius: 4px;
  background: #d1fae5;
  color: #065f46;
}

.status-text.injured {
  background: #fee2e2;
  color: #991b1b;
}

.score-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.score-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px;
  background: #f3f4f6;
  border-radius: 12px;
}

.score-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.score-name {
  font-size: 16px;
  font-weight: 600;
  color: #1f2937;
}

.score-points {
  font-size: 14px;
  color: #6b7280;
}

.score-rank {
  font-size: 18px;
  font-weight: 700;
  color: #f59e0b;
  padding: 8px 12px;
  border-radius: 8px;
  background: #fef3c7;
}

.empty-tip {
  text-align: center;
  padding: 40px 20px;
  color: #9ca3af;
  font-size: 14px;
}

.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60px 20px;
}

.spinner {
  width: 40px;
  height: 40px;
  border: 4px solid #e5e7eb;
  border-top-color: #3b82f6;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 16px;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
