.container {
  min-height: 100vh;
  background: #f7f8fa;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px;
  background: white;
  position: sticky;
  top: 0;
  z-index: 10;
}

.back-btn {
  font-size: 24px;
  color: #1f2937;
  padding: 8px;
  margin-left: -8px;
}

.title {
  font-size: 18px;
  font-weight: 600;
  color: #1f2937;
}

.placeholder {
  width: 32px;
}

/* Tab Bar */
.tab-bar {
  display: flex;
  background: white;
  padding: 8px 16px;
  gap: 6px;
  border-bottom: 1px solid #e5e7eb;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 8px 4px;
  font-size: 13px;
  font-weight: 500;
  color: #6b7280;
  border-radius: 8px;
  transition: all 0.2s ease;
}

.tab-item.active {
  background: #7c3aed;
  color: white;
  font-weight: 600;
}

.content {
  padding: 16px;
}

.section {
  background: white;
  border-radius: 16px;
  padding: 20px;
  margin-bottom: 16px;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16px;
}

.section-title {
  font-size: 16px;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 12px;
}

.priority-hint {
  font-size: 12px;
  padding: 4px 10px;
  background: #fef3c7;
  color: #92400e;
  border-radius: 6px;
}

/* Matchup Cards */
.matchup-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.matchup-card {
  background: #f3f4f6;
  border-radius: 12px;
  padding: 16px;
  transition: all 0.2s ease;
}

.matchup-card:active {
  background: #e5e7eb;
  transform: scale(0.98);
}

.matchup-players {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8px;
}

.matchup-player {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
}

.matchup-player .player-name {
  font-size: 14px;
  font-weight: 600;
  color: #1f2937;
}

.matchup-player .score {
  font-size: 18px;
  font-weight: 700;
  color: #7c3aed;
}

.seed-badge {
  font-size: 11px;
  padding: 2px 8px;
  border-radius: 4px;
  background: #ede9fe;
  color: #7c3aed;
  font-weight: 600;
}

.high-seed .seed-badge {
  background: #dbeafe;
  color: #2563eb;
}

.vs-text {
  font-size: 14px;
  font-weight: 700;
  color: #9ca3af;
  padding: 0 8px;
}

.matchup-status {
  text-align: center;
}

.status-badge {
  font-size: 11px;
  padding: 2px 8px;
  border-radius: 4px;
}

.status-badge.active {
  background: #d1fae5;
  color: #065f46;
}

.status-badge.completed {
  background: #e5e7eb;
  color: #6b7280;
}

.status-badge.upcoming {
  background: #fef3c7;
  color: #92400e;
}

/* Date Selector */
.date-selector {
  display: flex;
  gap: 8px;
  margin-bottom: 16px;
  overflow-x: auto;
}

.date-item {
  padding: 8px 16px;
  border-radius: 8px;
  font-size: 13px;
  background: #f3f4f6;
  color: #6b7280;
  white-space: nowrap;
  transition: all 0.2s ease;
}

.date-item.active {
  background: #7c3aed;
  color: white;
  font-weight: 600;
}

/* Matchup Detail */
.matchup-detail {
  margin-top: 12px;
}

.detail-row {
  display: flex;
  gap: 12px;
}

.detail-player {
  flex: 1;
  background: #f3f4f6;
  border-radius: 12px;
  padding: 16px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
}

.detail-player .label {
  font-size: 11px;
  color: #9ca3af;
  text-transform: uppercase;
}

.detail-player .player-name {
  font-size: 15px;
  font-weight: 600;
  color: #1f2937;
}

.detail-player .player-score {
  font-size: 22px;
  font-weight: 700;
  color: #7c3aed;
}

/* Action Bar */
.action-bar {
  display: flex;
  gap: 12px;
  margin-top: 16px;
}

.action-btn {
  flex: 1;
  text-align: center;
  padding: 12px;
  border-radius: 10px;
  font-size: 14px;
  font-weight: 600;
  transition: all 0.2s ease;
}

.action-btn.primary {
  background: #7c3aed;
  color: white;
}

.action-btn.secondary {
  background: #f3f4f6;
  color: #6b7280;
}

.action-btn:active {
  transform: scale(0.98);
}

/* Total Scores */
.total-scores {
  margin-top: 16px;
  padding: 16px;
  background: #f3f4f6;
  border-radius: 12px;
}

.score-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.score-label {
  font-size: 14px;
  font-weight: 500;
  color: #6b7280;
}

.score-value {
  font-size: 20px;
  font-weight: 700;
  color: #7c3aed;
}

/* Player Selection */
.player-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
  max-height: 50vh;
  overflow-y: auto;
}

.player-item {
  display: flex;
  align-items: center;
  padding: 14px 16px;
  background: #f3f4f6;
  border-radius: 10px;
  transition: all 0.2s ease;
  border: 2px solid transparent;
}

.player-item.selected {
  background: #ede9fe;
  border-color: #7c3aed;
}

.player-item:active {
  transform: scale(0.98);
}

.player-item .player-info {
  flex: 1;
}

.player-item .player-name {
  font-size: 15px;
  font-weight: 600;
  color: #1f2937;
}

.player-item .player-team {
  font-size: 12px;
  color: #6b7280;
  margin-top: 2px;
}

.player-item .player-stats {
  margin-right: 12px;
}

.player-item .season-avg {
  font-size: 14px;
  font-weight: 600;
  color: #7c3aed;
}

.check-mark {
  width: 24px;
  height: 24px;
  background: #7c3aed;
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
}

/* Confirm Bar */
.confirm-bar {
  margin-top: 16px;
}

.confirm-btn {
  display: block;
  text-align: center;
  padding: 14px;
  background: #7c3aed;
  color: white;
  border-radius: 10px;
  font-size: 16px;
  font-weight: 600;
  transition: all 0.2s ease;
}

.confirm-btn:active {
  background: #6d28d9;
  transform: scale(0.98);
}

/* Frozen List */
.frozen-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.frozen-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 16px;
  background: #f3f4f6;
  border-radius: 10px;
}

.frozen-item .player-info {
  flex: 1;
}

.frozen-item .player-name {
  font-size: 15px;
  font-weight: 600;
  color: #1f2937;
}

.frozen-item .frozen-date {
  font-size: 12px;
  color: #9ca3af;
  margin-top: 2px;
}

.frozen-tag {
  font-size: 11px;
  padding: 4px 8px;
  border-radius: 4px;
  background: #fee2e2;
  color: #991b1b;
}

.empty-tip {
  text-align: center;
  padding: 40px 20px;
  color: #9ca3af;
  font-size: 14px;
}

.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60px 20px;
}

.spinner {
  width: 40px;
  height: 40px;
  border: 4px solid #e5e7eb;
  border-top-color: #7c3aed;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 16px;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
