<view class="container">
  <view class="header">
    <view class="back-btn" bindtap="handleBack">←</view>
    <view class="title">季后赛</view>
    <view class="placeholder"></view>
  </view>

  <!-- Tab导航 -->
  <view class="tab-bar">
    <view class="tab-item {{activeTab === 'bracket' ? 'active' : ''}}" bindtap="switchTab" data-tab="bracket">对阵</view>
    <view class="tab-item {{activeTab === 'matchup' ? 'active' : ''}}" bindtap="switchTab" data-tab="matchup">详情</view>
    <view class="tab-item {{activeTab === 'select' ? 'active' : ''}}" bindtap="switchTab" data-tab="select">选人</view>
    <view class="tab-item {{activeTab === 'frozen' ? 'active' : ''}}" bindtap="switchTab" data-tab="frozen">冷冻</view>
  </view>

  <view class="content" wx:if="{{!loading}}">
    <!-- 对阵总览 Tab -->
    <view wx:if="{{activeTab === 'bracket'}}">
      <!-- 附加赛 -->
      <view class="section" wx:if="{{playoffStatus && playoffStatus.playIn}}">
        <view class="section-title">附加赛</view>
        <view class="matchup-list">
          <view class="matchup-card" wx:for="{{playoffStatus.playIn.matchups}}" wx:key="id" bindtap="viewMatchup" data-id="{{item.id}}">
            <view class="matchup-players">
              <view class="matchup-player high-seed">
                <text class="seed-badge">#{{item.high_seed_rank}}</text>
                <text class="player-name">{{item.high_seed_nickname || '玩家' + item.high_seed_rank}}</text>
                <text class="score">{{item.high_seed_points || 0}}分</text>
              </view>
              <text class="vs-text">VS</text>
              <view class="matchup-player low-seed">
                <text class="seed-badge">#{{item.low_seed_rank}}</text>
                <text class="player-name">{{item.low_seed_nickname || '玩家' + item.low_seed_rank}}</text>
                <text class="score">{{item.low_seed_points || 0}}分</text>
              </view>
            </view>
            <view class="matchup-status">
              <text class="status-badge {{item.status}}">{{item.status === 'active' ? '进行中' : item.status === 'completed' ? '已结束' : '待开始'}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 季后赛正赛 -->
      <view class="section" wx:if="{{playoffStatus && playoffStatus.rounds && playoffStatus.rounds.length > 0}}">
        <view class="section-title" wx:for="{{playoffStatus.rounds}}" wx:key="round_type">
          {{item.round_type === 'round1' ? '季后赛第一轮' : item.round_type === 'round2' ? '半决赛' : '总决赛'}}
        </view>
        <view class="matchup-list">
          <view class="matchup-card" wx:for="{{playoffStatus.currentRoundMatchups}}" wx:key="id" bindtap="viewMatchup" data-id="{{item.id}}">
            <view class="matchup-players">
              <view class="matchup-player high-seed">
                <text class="seed-badge">#{{item.high_seed_rank}}</text>
                <text class="player-name">{{item.high_seed_nickname || '玩家' + item.high_seed_rank}}</text>
                <text class="score">{{item.high_seed_points || 0}}分</text>
              </view>
              <text class="vs-text">VS</text>
              <view class="matchup-player low-seed">
                <text class="seed-badge">#{{item.low_seed_rank}}</text>
                <text class="player-name">{{item.low_seed_nickname || '玩家' + item.low_seed_rank}}</text>
                <text class="score">{{item.low_seed_points || 0}}分</text>
              </view>
            </view>
            <view class="matchup-status">
              <text class="status-badge {{item.status}}">{{item.status === 'active' ? '进行中' : item.status === 'completed' ? '已结束' : '待开始'}}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="empty-tip" wx:if="{{!playoffStatus || (!playoffStatus.playIn && (!playoffStatus.rounds || playoffStatus.rounds.length === 0))}}">
        <text>季后赛尚未开始</text>
      </view>
    </view>

    <!-- 对阵详情 Tab -->
    <view wx:if="{{activeTab === 'matchup'}}">
      <view class="section" wx:if="{{currentMatchup}}">
        <view class="section-title">
          #{{currentMatchup.high_seed_rank}} vs #{{currentMatchup.low_seed_rank}}
        </view>

        <!-- 比赛日选择 -->
        <view class="date-selector" wx:if="{{gameDates.length > 0}}">
          <view class="date-item {{selectedGameDate === item ? 'active' : ''}}"
                wx:for="{{gameDates}}" wx:key="*this"
                bindtap="selectGameDate" data-date="{{item}}">
            {{item}}
          </view>
        </view>

        <!-- 双方选人对比 -->
        <view class="matchup-detail" wx:if="{{selectedGameDate}}">
          <view class="detail-row">
            <view class="detail-player">
              <text class="label">高种子</text>
              <text class="player-name">{{currentMatchup.highSeedSelection.player_name || '未选择'}}</text>
              <text class="player-score">{{currentMatchup.highSeedSelection.plus58_score || '-'}}</text>
            </view>
            <view class="detail-player">
              <text class="label">低种子</text>
              <text class="player-name">{{currentMatchup.lowSeedSelection.player_name || '未选择'}}</text>
              <text class="player-score">{{currentMatchup.lowSeedSelection.plus58_score || '-'}}</text>
            </view>
          </view>
        </view>

        <!-- 选人按钮 -->
        <view class="action-bar" wx:if="{{currentMatchup.status === 'active' && selectedGameDate}}">
          <text class="action-btn primary" bindtap="goToSelect">选择球员</text>
          <text class="action-btn secondary" bindtap="cancelSelection">取消选人</text>
        </view>

        <!-- 总积分 -->
        <view class="total-scores" wx:if="{{currentMatchup.scores}}">
          <view class="score-summary">
            <text class="score-label">总积分</text>
            <text class="score-value">{{currentMatchup.scores.highSeedTotal || 0}} - {{currentMatchup.scores.lowSeedTotal || 0}}</text>
          </view>
        </view>
      </view>

      <view class="empty-tip" wx:else>
        <text>请先在对阵页面选择一组对决</text>
      </view>
    </view>

    <!-- 选人 Tab -->
    <view wx:if="{{activeTab === 'select'}}">
      <view class="section" wx:if="{{currentMatchup}}">
        <view class="section-header">
          <view class="section-title">选择球员 - {{selectedGameDate}}</view>
          <text class="priority-hint" wx:if="{{currentMatchup.hasPriority}}">
            你有优先选择权
          </text>
        </view>

        <view class="player-list" wx:if="{{availablePlayers.length > 0}}">
          <view class="player-item {{selectedPlayerId === item.player_id ? 'selected' : ''}}"
                wx:for="{{availablePlayers}}" wx:key="player_id"
                bindtap="selectPlayer" data-player-id="{{item.player_id}}">
            <view class="player-info">
              <text class="player-name">{{item.player_name}}</text>
              <text class="player-team">{{item.team_name}}</text>
            </view>
            <view class="player-stats">
              <text class="season-avg">场均 {{item.season_avg || 0}}</text>
            </view>
            <view class="check-mark" wx:if="{{selectedPlayerId === item.player_id}}">✓</view>
          </view>
        </view>

        <view class="empty-tip" wx:else>
          <text>没有可选球员</text>
        </view>

        <view class="confirm-bar" wx:if="{{selectedPlayerId}}">
          <text class="confirm-btn" bindtap="confirmSelection">确认选择</text>
        </view>
      </view>

      <view class="empty-tip" wx:else>
        <text>请先选择对阵和比赛日</text>
      </view>
    </view>

    <!-- 冷冻名单 Tab -->
    <view wx:if="{{activeTab === 'frozen'}}">
      <view class="section">
        <view class="section-title">当前轮次冷冻名单</view>
        <view class="frozen-list" wx:if="{{frozenPlayers.length > 0}}">
          <view class="frozen-item" wx:for="{{frozenPlayers}}" wx:key="id">
            <view class="player-info">
              <text class="player-name">{{item.player_name}}</text>
              <text class="frozen-date">{{item.frozen_date}}</text>
            </view>
            <text class="frozen-tag">冷冻</text>
          </view>
        </view>
        <view class="empty-tip" wx:else>
          <text>暂无冷冻球员</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 加载中 -->
  <view class="loading-container" wx:if="{{loading}}">
    <view class="spinner"></view>
    <text>加载中...</text>
  </view>
</view>
