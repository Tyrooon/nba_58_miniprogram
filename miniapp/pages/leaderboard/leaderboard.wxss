.page-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #1E3A8A 0%, #3B82F6 100%);
  padding: 32rpx;
  padding-bottom: 120rpx;
}

/* Header */
.header {
  text-align: center;
  padding: 40rpx 0 60rpx;
}

.header-title {
  font-size: 56rpx;
  font-weight: 800;
  color: white;
  margin-bottom: 16rpx;
}

.header-subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* Loading */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  color: rgba(255, 255, 255, 0.8);
  font-size: 28rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: white;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* Leaderboard List */
.leaderboard-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* Rank Card */
.rank-card {
  background: white;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
  transition: transform 0.2s;
}

.rank-card.is-me {
  background: linear-gradient(135deg, #FEF3C7 0%, #FDE68A 100%);
  border: 2rpx solid #F59E0B;
}

.rank-card.top-three {
  background: linear-gradient(135deg, #FFF7ED 0%, #FFEDD5 100%);
}

/* Rank Badge */
.rank-badge {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.rank-badge.rank-1 {
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  font-size: 36rpx;
}

.rank-badge.rank-2 {
  background: linear-gradient(135deg, #E5E7EB 0%, #9CA3AF 100%);
  font-size: 36rpx;
}

.rank-badge.rank-3 {
  background: linear-gradient(135deg, #FED7AA 0%, #F97316 100%);
  font-size: 36rpx;
}

.rank-badge.rank-normal {
  background: #F3F4F6;
  color: #6B7280;
}

/* User Info */
.user-info {
  flex: 1;
  display: flex;
  align-items: center;
  min-width: 0;
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: #E5E7EB;
  flex-shrink: 0;
}

.user-detail {
  flex: 1;
  min-width: 0;
}

.user-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2937;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.me-tag {
  font-size: 20rpx;
  background: #3B82F6;
  color: white;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

/* Score Section */
.score-section {
  display: flex;
  align-items: baseline;
  flex-shrink: 0;
}

.score-value {
  font-size: 44rpx;
  font-weight: 800;
  color: #3B82F6;
}

.score-label {
  font-size: 24rpx;
  color: #9CA3AF;
  margin-left: 8rpx;
}

/* Empty State */
.empty-state {
  text-align: center;
  padding: 120rpx 0;
  color: rgba(255, 255, 255, 0.8);
}

.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
}
