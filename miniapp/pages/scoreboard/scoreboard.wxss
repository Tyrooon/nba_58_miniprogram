.page-container {
  background-color: #f7f8fa;
  min-height: 100vh;
  padding-bottom: env(safe-area-inset-bottom);
}

/* Nav Bar */
.nav-bar {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background: white;
  border-bottom: 1px solid #E5E7EB;
}

.nav-back,
.nav-home {
  font-size: 28rpx;
  color: #3B82F6;
  font-weight: 500;
}

/* Header */
.header {
  padding: 30rpx;
  text-align: center;
  background: white;
}

.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1F2937;
  margin-bottom: 8rpx;
}

.header-subtitle {
  font-size: 26rpx;
  color: #6B7280;
}

/* Date Picker */
.date-picker-section {
  padding: 20rpx 30rpx;
  background: white;
}

.date-picker-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 20rpx 30rpx;
  background: #F3F4F6;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #374151;
}

.picker-arrow {
  font-size: 20rpx;
  color: #9CA3AF;
}

/* Tabs */
.scoreboard-tabs {
  display: flex;
  background: white;
  border-bottom: 1px solid #E5E7EB;
}

.sb-tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #6B7280;
  position: relative;
  transition: all 0.2s;
}

.sb-tab.active {
  color: #3B82F6;
  font-weight: 600;
}

.sb-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: #3B82F6;
  border-radius: 2rpx;
}

/* Formula */
.scoreboard-formula {
  padding: 16rpx 30rpx;
  font-size: 24rpx;
  color: #6B7280;
  background: #F9FAFB;
  text-align: center;
}

/* Loading */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx;
  gap: 20rpx;
  color: #9CA3AF;
  font-size: 28rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #E5E7EB;
  border-top-color: #3B82F6;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* List */
.scoreboard-list {
  height: calc(100vh - 400rpx);
  padding: 20rpx 30rpx;
}

/* Card */
.sc-card {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.sc-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.sc-user {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2937;
}

.sc-total {
  font-size: 32rpx;
  font-weight: 800;
}

.sc-total.positive {
  color: #10B981;
}

.sc-total.negative {
  color: #EF4444;
}

.sc-body {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #6B7280;
}

.sc-player {
  color: #374151;
}

.sc-actual {
  color: #3B82F6;
  font-weight: 500;
}

.sc-calc {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1px dashed #E5E7EB;
  font-size: 22rpx;
  color: #9CA3AF;
  text-align: right;
}

/* Empty */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx;
  gap: 20rpx;
}

.empty-icon {
  font-size: 60rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #9CA3AF;
}
