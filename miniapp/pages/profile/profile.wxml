<view class="page-container">
  <!-- User Info Card -->
  <view class="user-card">
    <view class="user-header" wx:if="{{user}}">
      <!-- 已关联账号：可修改头像；未关联：灰色默认头像 -->
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <view class="avatar-wrapper avatar-small">
          <image class="avatar" src="{{user.avatarUrl}}" mode="aspectFill"></image>
          <view class="avatar-edit-hint">修改</view>
        </view>
      </button>
      <view class="user-meta">
        <view class="username-row">
          <input
            class="nickname-input"
            type="nickname"
            placeholder="点击设置昵称"
            value="{{user.nickname || ''}}"
            bindblur="onNicknameInput"
            bindconfirm="onNicknameInput"
          />
          <text class="edit-icon">✏️</text>
        </view>
        <view class="user-group">
          <text class="group-icon">🏆</text>
          <text>{{user.groupName || '默认小组'}}</text>
        </view>
      </view>
    </view>

    <!-- 未关联：点击头像/昵称区域弹出绑定弹窗 -->
    <view class="user-header" wx:else bindtap="onTapLoginArea">
      <view class="avatar-wrapper avatar-small">
        <view class="avatar avatar-placeholder"></view>
      </view>
      <view class="user-meta">
        <view class="username-row">
          <text class="nickname-placeholder">待登陆</text>
        </view>
        <view class="user-group">
          <text class="group-icon">🏆</text>
          <text>未登录</text>
        </view>
      </view>
    </view>

    <view class="stats-row">
      <view class="stat-item">
        <view class="stat-label">积分</view>
        <view class="stat-value">{{displayScore}}</view>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <view class="stat-label">Bonus</view>
        <view class="stat-value">{{displayBonus}}</view>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <view class="stat-label">排名</view>
        <view class="stat-value">{{user ? (userRank || '--') : '--'}}</view>
      </view>
    </view>
  </view>

  <!-- Menu List -->
  <view class="menu-list">
    <!-- 已关联账号显示 -->
    <view class="menu-item menu-item-readonly" wx:if="{{user && user.username}}">
      <view class="menu-icon" style="background: #ECFDF5; color: #10B981;">✅</view>
      <view class="menu-text">已关联: {{user.username}}</view>
    </view>

    <view class="menu-item" data-url="/pages/history/history" bindtap="navigate" wx:if="{{user}}">
      <view class="menu-icon" style="background: #EFF6FF; color: #3B82F6;">📅</view>
      <view class="menu-text">历史战绩</view>
      <view class="menu-arrow">></view>
    </view>
    <view class="menu-item" data-url="/pages/leaderboard/leaderboard" bindtap="navigate">
      <view class="menu-icon" style="background: #FEF3C7; color: #F59E0B;">📊</view>
      <view class="menu-text">排行榜</view>
      <view class="menu-arrow">></view>
    </view>
    <!-- 每日得分看板 - 跳转到单独页面 -->
    <view class="menu-item" data-url="/pages/scoreboard/scoreboard" bindtap="navigate">
      <view class="menu-icon" style="background: #E0E7FF; color: #4F46E5;">🗓️</view>
      <view class="menu-text">每日得分看板</view>
      <view class="menu-arrow">></view>
    </view>
  </view>

  <!-- Frozen Players Section -->
  <view class="section-title">我的冷冻名单</view>
  <view class="frozen-list">
    <block wx:if="{{user && frozen.length}}">
      <block wx:for="{{frozen}}" wx:key="id">
        <view class="frozen-card">
          <view class="frozen-info">
            <view class="frozen-name-row">
              <text class="frozen-name">{{item.player_name}}</text>
              <text class="frozen-mode-tag">{{item.modeName || '常规'}}</text>
            </view>
            <view class="frozen-date">解冻: {{item.expires_at}}</view>
          </view>
          <view class="frozen-status">❄️</view>
        </view>
      </block>
    </block>
    <view class="empty-frozen" wx:if="{{!user}}">
      <view class="empty-text">关联账号后可查看</view>
    </view>
    <view class="empty-frozen" wx:elif="{{!frozen.length}}">
      <view class="empty-text">暂无冷冻球员</view>
    </view>
  </view>

</view>

<!-- 关联账号弹窗 -->
<view class="modal-mask" wx:if="{{showLinkModal}}" catchtap="hideLinkAccountModal">
  <view class="modal-container" catchtap="preventBubble">
    <view class="modal-header">
      <text class="modal-title">关联网页端账号</text>
      <text class="modal-close" catchtap="hideLinkAccountModal">×</text>
    </view>
    <view class="modal-body" catchtap="preventBubble">
      <view class="modal-tip">请输入您在网页端注册的用户名和密码，关联后可同步您的积分数据</view>
      <view class="form-item">
        <text class="form-label">用户名</text>
        <input class="form-input" placeholder="请输入用户名" value="{{linkUsername}}" bindinput="onLinkUsernameInput" catchtap="preventBubble" />
      </view>
      <view class="form-item">
        <text class="form-label">密码</text>
        <input class="form-input" placeholder="请输入密码" password value="{{linkPassword}}" bindinput="onLinkPasswordInput" catchtap="preventBubble" />
      </view>
    </view>
    <view class="modal-footer" catchtap="preventBubble">
      <button class="modal-btn modal-btn-cancel" catchtap="hideLinkAccountModal">取消</button>
      <button class="modal-btn modal-btn-confirm" catchtap="confirmLinkAccount" loading="{{linking}}">确认关联</button>
    </view>
  </view>
</view>
