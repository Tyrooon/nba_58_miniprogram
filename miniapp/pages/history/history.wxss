.page {
  padding: 32rpx;
  padding-top: 16rpx;
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding: 16rpx 0;
}

.nav-back {
  font-size: 28rpx;
  color: #3B82F6;
  font-weight: 500;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F2937;
}

.nav-home {
  font-size: 28rpx;
  color: #3B82F6;
  font-weight: 500;
}

.row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.mode {
  font-weight: 600;
}

.score {
  color: #fbbf24;
}

.player {
  font-size: 30rpx;
  font-weight: 600;
}

.meta {
  margin-top: 8rpx;
  opacity: 0.7;
  font-size: 24rpx;
}

.empty {
  text-align: center;
  opacity: 0.6;
  margin-top: 200rpx;
}









