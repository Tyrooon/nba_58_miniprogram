{
  "name": "nba-guess-server",
  "version": "1.0.0",
  "description": "NBA球星58竞猜小程序后端（Node.js + Express）",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "build-stats": "ts-node-dev --transpile-only src/scripts/buildSeasonStats.ts",
    "build-stats:batch": "ts-node-dev --transpile-only src/scripts/buildSeasonStats.ts --batch 20"
  },
  "keywords": [
    "wechat-mini-program",
    "nba",
    "express",
    "game"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@types/node-fetch": "^2.6.13",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dayjs": "^1.11.10",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "multer": "^2.0.2",
    "node-cron": "^3.0.3",
    "node-fetch": "^2.7.0",
    "sqlite3": "^5.1.7",
    "typescript": "^5.4.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.11.30",
    "@types/node-cron": "^3.0.11",
    "@types/sqlite3": "^3.1.11",
    "ts-node-dev": "^2.0.0"
  }
}
